# Set the final HTTPS origin. Netlify can fall back to its automatic primary URL.
# Do not use a deploy-preview URL here.
NEXT_PUBLIC_SITE_URL=
# Optional verified Maps listing URL; otherwise an address search is used.
NEXT_PUBLIC_MAP_URL=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Enable only with a real GA4 ID and matching published privacy text.
NEXT_PUBLIC_ENABLE_ANALYTICS=false
# Real GA4 Measurement ID (G-...). No script loads without both settings.
# Disable Enhanced Measurement auto page views, outbound clicks, forms and search
# in the stream: this site sends manual views and privacy-safe booking clicks.
NEXT_PUBLIC_GA_ID=
