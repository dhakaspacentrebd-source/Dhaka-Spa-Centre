# Set the final HTTPS origin. Netlify can fall back to its automatic primary URL.
# Do not use a deploy-preview URL here.
NEXT_PUBLIC_SITE_URL=
# Optional verified Maps listing URL; otherwise an address search is used.
NEXT_PUBLIC_MAP_URL=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Enable only after configuring an analytics consumer and reviewing privacy text.
NEXT_PUBLIC_ENABLE_ANALYTICS=false
# Reserved; no analytics provider script is loaded automatically.
NEXT_PUBLIC_GA_ID=
